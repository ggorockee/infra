{
  "uid": "reviewmaps-cronjob",
  "title": "ReviewMaps CronJob & DB 적재",
  "tags": [
    "reviewmaps",
    "cronjob"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "CronJob 상태 (kube-state-metrics)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "마지막 성공 후 경과 시간",
      "description": "26시간 초과 시 빨간색 (ReviewmapsCronJobNotSucceeded 알림 기준)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - kube_cronjob_status_last_successful_time{namespace=\"reviewmaps\"}",
          "legendFormat": "{{cronjob}}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 10,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "다음 실행 예정",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_cronjob_next_schedule_time{namespace=\"reviewmaps\"} * 1000",
          "legendFormat": "{{cronjob}}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "id": 3,
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 7,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "실패 Job (현재 보존 중)",
      "description": "실패 Job은 TTL(1시간) 동안 보존됨. 0이 정상",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_job_status_failed{namespace=\"reviewmaps\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "id": 4,
      "gridPos": {
        "x": 17,
        "y": 1,
        "w": 3,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "실행 중 Job",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_job_status_active{namespace=\"reviewmaps\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 5,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "state-timeline",
      "title": "Job 실행 구간 (실행 중=1)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (job_name) (kube_job_status_active{namespace=\"reviewmaps\"})",
          "legendFormat": "{{job_name}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      }
    },
    {
      "type": "table",
      "title": "최근 Job 실행 시간 (TTL 1시간 내 Job만 표시)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_job_status_completion_time{namespace=\"reviewmaps\"} - kube_job_status_start_time{namespace=\"reviewmaps\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true
            },
            "renameByName": {
              "job_name": "Job",
              "Value": "실행 시간"
            }
          }
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 5
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "DB 적재 확인 (Cloud SQL campaign 테이블)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "오늘(KST) 적재 건수",
      "description": "go-scraper는 DELETE 후 INSERT로 저장하므로 created_at = 마지막 수집 시각",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reviewmaps-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reviewmaps-db"
          },
          "rawSql": "SELECT count(*) AS \"오늘 적재\" FROM campaign WHERE deleted_at IS NULL AND created_at >= date_trunc('day', now() AT TIME ZONE 'Asia/Seoul') AT TIME ZONE 'Asia/Seoul'",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 5,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "활성 캠페인 (soft delete 제외)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reviewmaps-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reviewmaps-db"
          },
          "rawSql": "SELECT count(*) AS \"활성 캠페인\" FROM campaign WHERE deleted_at IS NULL",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 10,
      "gridPos": {
        "x": 5,
        "y": 20,
        "w": 5,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "마지막 적재 시각",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reviewmaps-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reviewmaps-db"
          },
          "rawSql": "SELECT extract(epoch FROM max(created_at)) * 1000 AS \"마지막 적재\" FROM campaign",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 11,
      "gridPos": {
        "x": 10,
        "y": 20,
        "w": 5,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "마감 지난 잔존 캠페인 (cleanup 검증)",
      "description": "cleanup은 soft delete(deleted_at 설정). 05:00 cleanup 이후 0이 정상",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reviewmaps-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reviewmaps-db"
          },
          "rawSql": "SELECT count(*) AS \"잔존\" FROM campaign WHERE deleted_at IS NULL AND apply_deadline < date_trunc('day', now() AT TIME ZONE 'Asia/Seoul') AT TIME ZONE 'Asia/Seoul'",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "id": 12,
      "gridPos": {
        "x": 15,
        "y": 20,
        "w": 9,
        "h": 5
      }
    },
    {
      "type": "barchart",
      "title": "오늘(KST) 플랫폼별 적재 건수",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reviewmaps-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reviewmaps-db"
          },
          "rawSql": "SELECT platform AS \"플랫폼\", count(*) AS \"건수\" FROM campaign WHERE deleted_at IS NULL AND created_at >= date_trunc('day', now() AT TIME ZONE 'Asia/Seoul') AT TIME ZONE 'Asia/Seoul' GROUP BY platform ORDER BY 2 DESC",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        }
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "플랫폼별 마지막 적재 (오래된 순)",
      "description": "마지막 적재가 1일 이상 지난 플랫폼은 수집이 중단됐거나 신규 캠페인이 없는 상태",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reviewmaps-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reviewmaps-db"
          },
          "rawSql": "SELECT platform AS \"플랫폼\", count(*) AS \"보유 건수\", max(created_at) AS \"마지막 적재\", round(extract(epoch FROM now() - max(created_at)) / 3600) AS \"경과(시간)\" FROM campaign WHERE deleted_at IS NULL GROUP BY platform ORDER BY max(created_at) ASC",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "경과(시간)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 26
                    },
                    {
                      "color": "red",
                      "value": 72
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "id": 14,
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "timeseries",
      "title": "캠페인 마지막 갱신일 분포 (최근 14일)",
      "description": "오늘 막대가 작고 과거 막대가 크면 최근 수집이 실패한 것",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reviewmaps-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reviewmaps-db"
          },
          "rawSql": "SELECT date_trunc('day', created_at AT TIME ZONE 'Asia/Seoul') AT TIME ZONE 'Asia/Seoul' AS time, count(*) AS \"캠페인 수\" FROM campaign WHERE deleted_at IS NULL AND created_at >= now() - interval '14 days' GROUP BY 1 ORDER BY 1",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      }
    }
  ]
}
