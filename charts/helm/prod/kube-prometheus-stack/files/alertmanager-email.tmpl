{{/*
  [커스텀] Alertmanager 이메일 템플릿 (ConfigMap alertmanager-email-templates로 마운트)
  - 기본 템플릿 email.default.subject / email.default.html 을 재정의하여 제목·본문을 한글로 단순화
  - 제목 접두어: [CRITICAL]=critical, [ERROR]=error, [WARN]=warning, [INFO]=info, [RESOLVED]=해제
*/}}

{{ define "custom.tag" }}{{ if eq .Status "resolved" }}[RESOLVED]{{ else if eq .CommonLabels.severity "critical" }}[CRITICAL]{{ else if eq .CommonLabels.severity "error" }}[ERROR]{{ else if eq .CommonLabels.severity "warning" }}[WARN]{{ else }}[INFO]{{ end }}{{ end }}

{{ define "custom.color" }}{{ if eq .Status "resolved" }}#2e7d32{{ else if eq .CommonLabels.severity "critical" }}#8e0000{{ else if eq .CommonLabels.severity "error" }}#c62828{{ else if eq .CommonLabels.severity "warning" }}#ef6c00{{ else }}#1565c0{{ end }}{{ end }}

{{ define "email.default.subject" }}{{ template "custom.tag" . }} {{ with index .Alerts 0 }}{{ if .Annotations.summary }}{{ .Annotations.summary }}{{ else }}{{ .Labels.alertname }}{{ end }}{{ end }}{{ if gt (len .Alerts) 1 }} (총 {{ len .Alerts }}건){{ end }}{{ end }}

{{ define "email.default.html" }}<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"></head>
<body style="font-family: -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif; color: #212121; margin: 0; padding: 16px;">
  <div style="border-left: 6px solid {{ template "custom.color" . }}; padding: 4px 0 4px 12px; margin-bottom: 16px;">
    <div style="font-size: 18px; font-weight: bold;">{{ template "email.default.subject" . }}</div>
  </div>
  {{ range .Alerts }}
  <table cellpadding="6" cellspacing="0" style="border-collapse: collapse; width: 100%; max-width: 720px; margin-bottom: 16px; font-size: 14px;">
    {{ if .Annotations.summary }}<tr><td style="width: 110px; color: #616161; border-bottom: 1px solid #eee;">요약</td><td style="border-bottom: 1px solid #eee;">{{ .Annotations.summary }}</td></tr>{{ end }}
    {{ if .Annotations.description }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">내용</td><td style="border-bottom: 1px solid #eee;">{{ .Annotations.description }}</td></tr>{{ end }}
    {{ if .Labels.scraper }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">스크래퍼</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.scraper }}</td></tr>{{ end }}
    {{ if .Labels.keyword }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">키워드</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.keyword }}</td></tr>{{ end }}
    {{ if .Labels.owner_name }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">CronJob</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.owner_name }}</td></tr>{{ end }}
    {{ if .Labels.job_name }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">Job</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.job_name }}</td></tr>{{ end }}
    {{ if .Labels.target }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">검사 대상</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.target }}{{ if .Labels.instance }} ({{ .Labels.instance }}){{ end }}</td></tr>{{ else if .Labels.instance }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">인스턴스</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.instance }}</td></tr>{{ end }}
    {{ if .Labels.destination_service_name }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">서비스</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.destination_service_name }}</td></tr>{{ end }}
    {{ if .Labels.deployment }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">Deployment</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.deployment }}</td></tr>{{ end }}
    {{ if .Labels.statefulset }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">StatefulSet</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.statefulset }}</td></tr>{{ end }}
    {{ if .Labels.pod }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">Pod</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.pod }}{{ if .Labels.container }} / {{ .Labels.container }}{{ end }}</td></tr>{{ end }}
    {{ if .Labels.persistentvolumeclaim }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">PVC</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.persistentvolumeclaim }}</td></tr>{{ end }}
    {{ if .Labels.datname }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">DB</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.datname }}</td></tr>{{ end }}
    {{ if .Labels.name }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">이름</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.name }}</td></tr>{{ end }}
    <tr><td style="color: #616161; border-bottom: 1px solid #eee;">등급</td><td style="border-bottom: 1px solid #eee;">{{ if eq .Labels.severity "critical" }}CRITICAL (서비스 중단, 즉시 조치){{ else if eq .Labels.severity "error" }}ERROR (기능 실패, 조치 필요){{ else if eq .Labels.severity "warning" }}WARN (정상 범위 벗어남){{ else }}INFO (참고용){{ end }}</td></tr>
    {{ if .Labels.namespace }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">네임스페이스</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.namespace }}</td></tr>{{ end }}
    <tr><td style="color: #616161; border-bottom: 1px solid #eee;">알림 이름</td><td style="border-bottom: 1px solid #eee;">{{ .Labels.alertname }}</td></tr>
    <tr><td style="color: #616161; border-bottom: 1px solid #eee;">발생 시각</td><td style="border-bottom: 1px solid #eee;">{{ .StartsAt | tz "Asia/Seoul" | date "2006-01-02 15:04:05 KST" }}</td></tr>
    {{ if eq .Status "resolved" }}<tr><td style="color: #616161; border-bottom: 1px solid #eee;">해제 시각</td><td style="border-bottom: 1px solid #eee;">{{ .EndsAt | tz "Asia/Seoul" | date "2006-01-02 15:04:05 KST" }}</td></tr>{{ end }}
  </table>
  {{ end }}
  <div style="font-size: 13px;">
    대시보드: <a href="https://monitoring.ggorockee.com/d/cluster-overview" style="color: #1565c0;">클러스터 전체 현황</a> ·
    <a href="https://monitoring.ggorockee.com/d/reviewmaps-scraper" style="color: #1565c0;">수집 서버</a> ·
    <a href="https://monitoring.ggorockee.com/d/reviewmaps-cronjob" style="color: #1565c0;">CronJob &amp; DB 적재</a> ·
    <a href="https://monitoring.ggorockee.com/d/reviewmaps-http-metrics" style="color: #1565c0;">API 서버</a>
  </div>
</body>
</html>
{{ end }}
